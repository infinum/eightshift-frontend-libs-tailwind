{
	"name": "@eightshift/frontend-libs-tailwind",
	"version": "4.0.2",
	"description": "A framework for creating modern Gutenberg themes with styling provided by Tailwind CSS.",
	"author": {
		"name": "Eightshift team",
		"email": "team@eightshift.com",
		"url": "https://eightshift.com/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/infinum/eightshift-frontend-libs-tailwind.git"
	},
	"keywords": [
		"frontend",
		"css",
		"mixin",
		"js",
		"utility",
		"module",
		"WordPress",
		"tailwind",
		"TailwindCSS"
	],
	"bugs": {
		"url": "https://github.com/infinum/eightshift-frontend-libs-tailwind/issues"
	},
	"scripts": {
		"lintJs": "bun run fmt:check && bun run --bun eslint",
		"lint:tw": "node bin/tw-sweep.mjs",
		"test": "bun test",
		"prepare": "husky",
		"fmt": "bun fmt --no-script bun bin linters scripts eslint.config.mjs package.json",
		"fmt:check": "bun fmt --no-script --check bun bin linters scripts eslint.config.mjs package.json",
		"fmt:files": "bun fmt --no-script"
	},
	"bin": {
		"tw-sweep": "bin/tw-sweep.mjs",
		"eightshift-build": "bun/cli.mjs"
	},
	"homepage": "https://github.com/infinum/eightshift-frontend-libs-tailwind#readme",
	"license": "MIT",
	"dependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@stylistic/stylelint-plugin": "^5.3.1",
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/oxide": "^4.3.3",
		"browserslist": "^4.29.4",
		"enhanced-resolve": "^5.24.1",
		"es-module-lexer": "^2.1.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.10.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"glob": "^13.0.6",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lightningcss": "^1.33.0",
		"oxlint": "^1.89.0",
		"postcss": "^8.5.30",
		"postcss-value-parser": "^4.2.0",
		"sonner": "^2.0.8",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0"
	},
	"devDependencies": {
		"lint-staged": "^17.6.0",
		"@eightshift/ui-components": "8.5.0-beta.1"
	},
	"peerDependencies": {
		"@eightshift/ui-components": "^8.0.0 || 8.5.0-beta.1"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"sideEffects": false,
	"lint-staged": {
		"*.js": [
			"bun fmt --no-script",
			"eslint"
		]
	}
}
